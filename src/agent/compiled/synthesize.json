          "description": "User's role for RBAC context"
        },
        {
          "prefix": "Plan:",
          "description": "Execution plan from plan_node"
        },
        {
          "prefix": "Tool History:",
          "description": "Concatenated tool calls + results"
        },
        {
          "prefix": "Reasoning:",
          "description": "${reasoning}"
        },
        {
          "prefix": "Answer:",
          "description": "Synthesized answer with citations + audit line"
        }
      ]
    },
